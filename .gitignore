# ===================================
# SIH26107 - BIS Assistant .gitignore
# Covers: Node/MERN, Python/ML, Flutter/Dart
# ===================================

# ---------- Node / MERN (backend, React) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
build/
.next/
out/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
coverage/
*.tsbuildinfo

# ---------- Python / ML ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.eggs/
.ipynb_checkpoints/
*.ipynb_checkpoints
.pytest_cache/
.mypy_cache/

# ML model artifacts / datasets (large files — track separately or with Git LFS)
*.h5
*.pkl
*.pt
*.pth
*.onnx
*.pb
/ml-model/data/
/ml-model/checkpoints/
/ml-model/*.csv
/ml-model/*.zip

# ---------- Flutter / Dart ----------
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/.pub-cache/
**/.pub/
**/ios/Flutter/.last_build_id
*.iml
*.ipr
*.iws

# Flutter/Android
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
key.properties
*.jks
*.keystore

